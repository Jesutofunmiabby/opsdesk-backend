# Every environment variable the backend reads, with example values only.
# Copy this file to .env and fill in real values there. .env is ignored by
# Git: never commit real passwords or secrets.

# dev (the default: prints SQL and DEBUG logs) or prod (quiet logs, and no
# defaults for JWT_SECRET and DB_PASSWORD).
SPRING_PROFILES_ACTIVE=prod

# Where the database is. localhost on your computer; inside Docker Compose,
# the database container is called db:
#   jdbc:postgresql://db:5432/opsdesk
DB_URL=jdbc:postgresql://localhost:5432/opsdesk
DB_USER=opsdesk
# Required in prod.
DB_PASSWORD=change-me-to-a-real-password

# The frontend address allowed to call the API from a browser. Several can be
# given, separated by commas. 5173 is the Vite dev server; 3000 is the
# frontend in Docker Compose.
ALLOWED_ORIGIN=http://localhost:5173

# Signs login tokens. Required in prod, at least 32 characters. Make one with:
#   openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-value-of-at-least-32-characters
